{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:concordance:catalog:1",
  "title": "Native product catalog area",
  "description": "An area contains an array of native behavior contracts, in YAML or JSON.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/entry"
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    },
    "nonemptyTexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "result"
      ],
      "properties": {
        "trigger": {
          "$ref": "#/$defs/text"
        },
        "result": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "given",
        "when",
        "then"
      ],
      "properties": {
        "given": {
          "$ref": "#/$defs/text"
        },
        "when": {
          "$ref": "#/$defs/text"
        },
        "then": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "description": "implemented (shipped is a deprecated read alias), partial, missing or not-applicable.",
          "enum": [
            "implemented",
            "shipped",
            "partial",
            "missing",
            "not-applicable"
          ]
        },
        "source": {
          "$ref": "#/$defs/texts"
        },
        "tests": {
          "$ref": "#/$defs/texts"
        },
        "gap": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "implemented_by": {
          "$ref": "#/$defs/text"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "description": "Independent review of an implementation. verified is derived: an implemented status, at least one capture or journey, and a reviewer other than implemented_by.",
      "required": [
        "by",
        "at"
      ],
      "properties": {
        "by": {
          "$ref": "#/$defs/text"
        },
        "at": {
          "$ref": "#/$defs/date"
        },
        "commit": {
          "$ref": "#/$defs/text"
        },
        "baseline_commit": {
          "$ref": "#/$defs/text"
        },
        "captures": {
          "$ref": "#/$defs/texts"
        },
        "journeys": {
          "$ref": "#/$defs/texts"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "surfaces",
        "interactions",
        "states",
        "settings",
        "data",
        "copy",
        "accessibility",
        "design",
        "depends_on",
        "impact",
        "platforms",
        "acceptance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "surfaces": {
          "$ref": "#/$defs/nonemptyTexts"
        },
        "interactions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/interaction"
          }
        },
        "states": {
          "$ref": "#/$defs/nonemptyTexts"
        },
        "settings": {
          "$ref": "#/$defs/texts"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reads",
            "writes"
          ],
          "properties": {
            "reads": {
              "$ref": "#/$defs/texts"
            },
            "writes": {
              "$ref": "#/$defs/texts"
            }
          }
        },
        "copy": {
          "$ref": "#/$defs/texts"
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "identifier",
            "notes"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "identifier": {
              "type": "string"
            },
            "notes": {
              "$ref": "#/$defs/texts"
            }
          }
        },
        "design": {
          "$ref": "#/$defs/texts"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "impact": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Optional product ordering within an impact tier; lower numbers come first."
        },
        "platforms": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/platform"
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        },
        "notes": {
          "$ref": "#/$defs/texts"
        },
        "verify_requires": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Evidence a verification must include. Default: capture, plus journey when data.writes is non-empty.",
          "items": {
            "enum": [
              "capture",
              "journey"
            ]
          }
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detail"
          }
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "number": {
      "type": "number"
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "description": "A measurable detail of an entry, referenced as entry-id#detail-id.",
      "required": [
        "id",
        "kind",
        "spec"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "motion",
            "haptic",
            "gesture",
            "geometry",
            "copy",
            "state",
            "accessibility",
            "layout",
            "other"
          ]
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/text"
            },
            "motion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "curve"
              ],
              "properties": {
                "curve": {
                  "enum": [
                    "spring",
                    "ease",
                    "linear"
                  ]
                },
                "response": {
                  "type": "number",
                  "minimum": 0
                },
                "damping": {
                  "type": "number",
                  "minimum": 0
                },
                "duration": {
                  "type": "number",
                  "minimum": 0
                },
                "bounce": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              }
            },
            "haptic": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            "gesture": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "$ref": "#/$defs/text"
                },
                "threshold": {
                  "$ref": "#/$defs/number"
                },
                "unit": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            "geometry": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "property",
                "value",
                "unit"
              ],
              "properties": {
                "property": {
                  "$ref": "#/$defs/text"
                },
                "value": {
                  "$ref": "#/$defs/number"
                },
                "unit": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            "copy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "$ref": "#/$defs/text"
                },
                "locale": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        },
        "baseline": {
          "$ref": "#/$defs/texts"
        },
        "platforms": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/platform"
          }
        }
      }
    }
  }
}
